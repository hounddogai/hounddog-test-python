# Copy this file to .env and fill in your own values.

# SQLAlchemy database URL. SQLite is the default; the file is created in the project root.
DATABASE_URL=sqlite:///data.db

# OpenAI API key for the AI Assistant tab on the Patient Management page.
OPENAI_API_KEY=your_openai_api_key_here

# Sentry DSN. Leave empty to disable Sentry.
SENTRY_DSN=
